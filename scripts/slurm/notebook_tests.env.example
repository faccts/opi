# shellcheck shell=bash
#
# Site configuration for the weekly OPI notebook test run.
#
#   cp notebook_tests.env.example notebook_tests.env
#
# and fill in every <<...>> placeholder. This file is sourced by BOTH the cron wrapper
# (on the submit host) and the job script (on the compute node), so it must contain
# variable assignments only -- no side effects, no output.

# ---------------------------------------------------------------------------
# Locations. Must be readable from the submit host AND the compute nodes.
# ---------------------------------------------------------------------------
OPI_NB_ROOT="$HOME/opi-notebook-tests"
OPI_NB_REPO="$OPI_NB_ROOT/repo"
OPI_NB_GIT_URL="https://github.com/faccts/opi.git"
OPI_NB_BRANCH="main"

# ---------------------------------------------------------------------------
# SLURM knobs.  <<< FILL IN >>>
# These are passed to `sbatch` on the command line by the cron wrapper, because
# #SBATCH directives are parsed before any shell runs and cannot read this file.
# ---------------------------------------------------------------------------
NB_JOB_NAME="opi-notebooks"
NB_PARTITION="<<partition>>"
NB_ACCOUNT=""                 # <<account>>, or leave empty if the site has no accounting
NB_QOS=""                     # optional
NB_TIME="12:00:00"
NB_CPUS=8                     # the largest `ncores` any notebook requests is 8
NB_MEM="32G"
NB_MAIL=""                    # e.g. you@faccts.de; empty => no mail
NB_EXTRA_SBATCH_ARGS=""       # e.g. "--constraint=avx2 --exclusive"

# ---------------------------------------------------------------------------
# Toolchain on the compute node.  <<< FILL IN >>>
# ---------------------------------------------------------------------------
# Directory holding the `orca` binary. If the install has bin/ and lib/ subfolders,
# point NB_ORCA_DIR at the *top* folder and set NB_ORCA_BIN_SUBDIR="bin".
NB_ORCA_DIR="<</path/to/orca_6_1_1_linux_x86-64_shared_openmpi418_avx2>>"
NB_ORCA_BIN_SUBDIR=""
# Open MPI *prefix* -- the directory containing bin/ and lib/. OPI appends those itself
# and resolves the path strictly, so a wrong value raises. Leave empty to rely on ORCA's
# bundled Open MPI being reachable via $PATH.
NB_MPI_PREFIX="<</path/to/openmpi>>"
# Directory containing the `uv` executable.
NB_UV_BIN="$HOME/.local/bin"
# cron gives you almost no PATH, and `sbatch --export=NONE` gives the job almost none.
NB_PATH_PREPEND="$NB_UV_BIN:/usr/local/bin:/usr/bin:/bin"
# Set these if the compute nodes reach the internet only through a proxy.
NB_HTTPS_PROXY=""
NB_HTTP_PROXY=""

# ---------------------------------------------------------------------------
# Node-local scratch. Empty => $SLURM_TMPDIR if the site sets it, else /tmp.
# ---------------------------------------------------------------------------
NB_SCRATCH_BASE=""

# ---------------------------------------------------------------------------
# Notebook selection and timeouts.
# ---------------------------------------------------------------------------
NB_SKIP="extopt,ir_spectrum,ml_properties,opencosmors"
NB_CELL_TIMEOUT=1800          # nbconvert timeout for a single CELL, seconds
NB_NOTEBOOK_TIMEOUT=5400      # hard cap for a whole NOTEBOOK, seconds
# Installed with `uv pip install` AFTER `uv sync`, so it never enters uv.lock.
# To enable opencosmors.ipynb, set this to the openCOSMO-RS git URL and drop
# "opencosmors" from NB_SKIP above.
NB_EXTRA_PIP=""
# Extra pytest arguments, word-split. Smoke test: NB_PYTEST_ARGS='-k how_to_opi'
NB_PYTEST_ARGS=""

# ---------------------------------------------------------------------------
# Wrapper behaviour.
# ---------------------------------------------------------------------------
NB_DRY_RUN=0                  # 1 => print the sbatch command instead of submitting
NB_KEEP_RUNS=12               # prune runs/ beyond this many entries
